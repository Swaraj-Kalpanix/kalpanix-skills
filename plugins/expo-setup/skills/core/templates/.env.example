# Copy to .env.local (gitignored) and adjust. Only EXPO_PUBLIC_* vars reach the app —
# they are embedded in the bundle, so never put secrets here.
# After changing them restart with a cleared cache: `npx expo start --clear` (values are inlined at build time).

# mock = in-memory mock server (default) · live = real API
EXPO_PUBLIC_API_MODE=mock

# Required when EXPO_PUBLIC_API_MODE=live. On a device/emulator use your machine's LAN IP,
# not localhost (Android emulator: http://10.0.2.2:<port>).
EXPO_PUBLIC_API_BASE_URL=

EXPO_PUBLIC_API_TIMEOUT_MS=30000

# Mock mode: send requests that have no mock to the real API (lets features go live one at a time).
EXPO_PUBLIC_MOCK_PASSTHROUGH=false
